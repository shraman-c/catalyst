# Copy this file to .env.local and fill in your values
# .env.local is already in .gitignore — do not commit it

# ============================
# REQUIRED: Groq API Key (LLM text generation — extraction, graph merge, cards)
# Create a free key at: https://console.groq.com/keys
# ============================
GROQ_API_KEY=

# ============================
# REQUIRED: Pinecone API Key (vector storage + embeddings via inference API)
# Create a free account at: https://app.pinecone.io
# ============================
PINECONE_API_KEY=
# Optional overrides (defaults work out of the box):
PINECONE_INDEX=default
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# ============================
# REQUIRED: Supabase Postgres connection string
# ============================
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ============================
# REQUIRED: Session secret (any random string, 32+ chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================
NEXTAUTH_SECRET=generate a 32 char string using the command above and paste it here

# App URL (keep as-is for local dev)
NEXTAUTH_URL=

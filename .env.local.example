# Copy this file to .env.local and fill in your values
# .env.local is already in .gitignore — do not commit it

# =============================================================
# REQUIRED: Google Gemini API Key
# Get a free key at: https://aistudio.google.com/app/apikey
# =============================================================
GEMINI_API_KEY=

DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# =============================================================
# REQUIRED: Session secret (any random string, 32+ chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================
NEXTAUTH_SECRET=generate a 32 char string using the command above and paste it here

# App URL (keep as-is for local dev)
NEXTAUTH_URL=http://localhost:3000


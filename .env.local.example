# Copy this file to .env.local and fill in your values
# .env.local is already in .gitignore — do not commit it

# =============================================================
# REQUIRED: Database (Supabase PostgreSQL)
# =============================================================
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# =============================================================
# REQUIRED: Groq API Key (LLM text generation)
# Get a free key at: https://console.groq.com/keys
# =============================================================
GROQ_API_KEY=

# =============================================================
# REQUIRED: Pinecone API Key (vector storage + embeddings)
# Get a free key at: https://app.pinecone.io
# =============================================================
PINECONE_API_KEY=

# =============================================================
# REQUIRED: Session secret (any random string, 32+ chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================
NEXTAUTH_SECRET=

# =============================================================
# REQUIRED: Device JWT secret (for watcher device pairing)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================
JWT_SECRET=

# =============================================================
# REQUIRED (production): Note content encryption key (any random string, 32+ chars)
# Encrypts note_versions.content at rest with AES-256-GCM (audit 6.6 / fix 3.3).
# REQUIRED in production - without it the app refuses to store notes in
# plaintext. In development a missing key stores plaintext with a warning.
# Generate with: node -e "console.log(require("crypto").randomBytes(32).toString("hex"))"
# WARNING: changing this key makes previously encrypted notes undecryptable.
# To encrypt existing plaintext notes: node --env-file=.env.local scripts/encrypt-existing-notes.mjs
# =============================================================
NOTE_ENCRYPTION_KEY=

# =============================================================
# OPTIONAL: Previous session secret (only during NEXTAUTH_SECRET rotation)
# Set this to the OLD NEXTAUTH_SECRET value while rotating so existing
# sessions keep verifying. Remove it once all old JWTs have expired.
# =============================================================
NEXTAUTH_SECRET_PREVIOUS=

# App URL (keep as-is for local dev)
NEXTAUTH_URL=http://localhost:3000
